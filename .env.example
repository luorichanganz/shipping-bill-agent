# OCR service
OCR_ENDPOINT=http://36.103.199.11:5002/process
OCR_TASK=orderChange
OCR_CONNECT_TIMEOUT=10
OCR_READ_TIMEOUT=300
OCR_MAX_RETRIES=2

# The OCR service accepts a URL. Publish local files under this public path.
OCR_PUBLIC_DIR=./tmp/ocr-public
OCR_PUBLIC_BASE_URL=http://127.0.0.1:8000
CHARGE_ALIAS_FILE=./data/charge_aliases.json

# OpenAI-compatible LLM extraction. Without a key, use --extractor heuristic.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0

# Optional low-confidence OCR review with a vision-capable model.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TEMPERATURE=0
VISION_MAX_IMAGE_DIMENSION=2000

# Agent safety and limits
CONFIDENCE_THRESHOLD=0.80
MAX_ATTACHMENT_DEPTH=4
MAX_ATTACHMENT_COUNT=30
MAX_ATTACHMENT_BYTES=26214400

